<div class="max-w-2xl mx-auto px-4 py-8">
  <div class="mb-6">
    <%= link_to "← Back to My Listings", my_listings_path, class: "text-indigo-600 hover:text-indigo-800 flex items-center font-medium" %>
  </div>

  <div class="bg-white rounded-lg shadow-lg p-8">
    <h1 class="text-2xl font-bold text-gray-900 mb-6">Edit Listing</h1>

    <%= form_with model: @listing, local: true, class: "space-y-6", html: { multipart: true } do |form| %>
      <div>
        <%= form.label :title, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.text_field :title, class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
      </div>

      <div>
        <%= form.label :description, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.text_area :description, rows: 4, class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <%= form.label :category, class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= form.select :category, @category_options, {}, class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
        </div>

        <div>
          <%= form.label :price_per_day, "Price per Day (₹)", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= form.number_field :price_per_day, step: 0.01, min: 0, class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
        </div>
      </div>

      <div>
        <p class="block text-sm font-medium text-gray-700 mb-2">Current Image</p>
        <% if @listing.image_name.present? %>
          <div class="relative inline-block">
            <%= image_tag listing_image_source(@listing), class: "w-32 h-32 object-cover rounded-md border border-gray-200" %>
          </div>
          <p class="text-xs text-gray-500 mt-2">Image: <%= @listing.image_name %></p>
        <% else %>
          <div class="w-32 h-32 bg-gray-200 rounded-md border border-gray-300 flex items-center justify-center">
            <svg class="w-12 h-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
            </svg>
          </div>
          <p class="text-xs text-gray-500 mt-2">No image uploaded. Default category image will be used.</p>
        <% end %>

        <details class="mt-4">
          <summary class="cursor-pointer text-sm text-indigo-600 hover:text-indigo-800 font-medium">📷 Change image (optional)</summary>
          <div class="mt-3 pl-4 border-l-2 border-indigo-200">
            <%= form.label :image_upload, "Upload new image", class: "block text-sm font-medium text-gray-700 mb-1" %>
            <%= form.file_field :image_upload, accept: ".jpg,.jpeg,.png,.webp,.svg,image/*", class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
            <p class="text-xs text-gray-500 mt-1">Leave empty to keep current image. Supports: JPG, PNG, WebP, SVG</p>
          </div>
        </details>
      </div>

      <div>
        <%= form.label :status, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.select :status, [["Available", "available"], ["Rented", "rented"], ["Unavailable", "unavailable"]], {}, class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
      </div>

      <div class="flex space-x-4 pt-4">
        <%= form.submit "Update Listing", class: "flex-1 bg-indigo-600 text-white px-6 py-3 rounded-md font-semibold hover:bg-indigo-700 transition cursor-pointer" %>
        <%= link_to "Cancel", my_listings_path, class: "flex-1 text-center bg-gray-300 text-gray-700 px-6 py-3 rounded-md font-semibold hover:bg-gray-400 transition block" %>
      </div>
    <% end %>
  </div>
</div>
