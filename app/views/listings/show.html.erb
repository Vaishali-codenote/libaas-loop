<div class="max-w-4xl mx-auto">
  <div class="mb-6">
    <%= link_to "← Back to Listings", listings_path, class: "text-indigo-600 hover:text-indigo-800" %>
  </div>

  <div class="bg-white rounded-lg shadow-lg overflow-hidden">
    <div class="grid grid-cols-1 md:grid-cols-2">
      <!-- Images -->
      <div class="bg-gray-100">
        <% if @listing.images.attached? %>
          <%= image_tag @listing.images.first, class: "w-full h-96 object-cover" %>
        <% else %>
          <div class="w-full h-96 bg-gray-200 flex items-center justify-center">
            <span class="text-gray-400">No image available</span>
          </div>
        <% end %>
      </div>

      <!-- Details -->
      <div class="p-8">
        <h1 class="text-3xl font-bold text-gray-900 mb-2"><%= @listing.title %></h1>
        <p class="text-gray-600 mb-4"><%= @listing.category %></p>
        <p class="text-3xl text-indigo-600 font-bold mb-6">₹<%= @listing.price_per_day %> <span class="text-sm text-gray-500">/ day</span></p>
        
        <div class="mb-6">
          <h3 class="font-semibold text-gray-900 mb-2">Description</h3>
          <p class="text-gray-700"><%= @listing.description %></p>
        </div>

        <div class="mb-6">
          <p class="text-gray-600">
            <span class="font-semibold">Listed by:</span> <%= @listing.user.name %>
          </p>
          <p class="text-gray-600">
            <span class="font-semibold">Status:</span> 
            <span class="px-2 py-1 rounded-full text-xs font-medium <%= @listing.available? ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' %>">
              <%= @listing.status %>
            </span>
          </p>
        </div>

        <% if user_signed_in? && @listing.user != current_user && @listing.available? %>
          <div class="border-t pt-6">
            <h3 class="font-semibold text-gray-900 mb-4">Rent this outfit</h3>
            <%= form_with model: [@listing, @rental], local: true, class: "space-y-4" do |form| %>
              <div>
                <%= form.label :start_date, "Start Date", class: "block text-sm font-medium text-gray-700 mb-1" %>
                <%= form.date_field :start_date, min: Date.today, class: "w-full border-gray-300 rounded-md shadow-sm focus:border-indigo-500 focus:ring-indigo-500", required: true %>
              </div>
              <div>
                <%= form.label :end_date, "End Date", class: "block text-sm font-medium text-gray-700 mb-1" %>
                <%= form.date_field :end_date, min: Date.today, class: "w-full border-gray-300 rounded-md shadow-sm focus:border-indigo-500 focus:ring-indigo-500", required: true %>
              </div>
              <%= form.submit "Request to Rent", class: "w-full bg-indigo-600 text-white px-6 py-3 rounded-md font-semibold hover:bg-indigo-700 transition cursor-pointer" %>
            <% end %>
          </div>
        <% elsif @listing.user == current_user %>
          <div class="border-t pt-6 flex space-x-4">
            <%= link_to "Edit Listing", edit_listing_path(@listing), class: "flex-1 text-center bg-gray-600 text-white px-6 py-3 rounded-md font-semibold hover:bg-gray-700 transition" %>
            <%= button_to "Delete Listing", listing_path(@listing), method: :delete, class: "flex-1 bg-red-600 text-white px-6 py-3 rounded-md font-semibold hover:bg-red-700 transition cursor-pointer", data: { confirm: "Are you sure?" } %>
          </div>
        <% elsif !@listing.available? %>
          <p class="text-red-600 font-medium">This listing is currently unavailable.</p>
        <% end %>
      </div>
    </div>
  </div>
</div>
