<div class="max-w-5xl mx-auto px-4 py-8">
  <div class="mb-6">
    <%= link_to "← Back to Listings", listings_path, class: "text-indigo-600 hover:text-indigo-800 flex items-center" %>
  </div>

  <div class="bg-white rounded-lg shadow-lg overflow-hidden">
    <div class="grid grid-cols-1 md:grid-cols-2">
      <!-- Images -->
      <div class="bg-gray-100">
        <%= image_tag listing_image_source(@listing), class: "w-full h-full object-cover min-h-[500px]" %>
      </div>

      <!-- Details -->
      <div class="p-8">
        <h1 class="text-3xl font-bold text-gray-900 mb-2"><%= @listing.title %></h1>
        <p class="text-gray-500 mb-4"><%= @listing.category.present? ? @listing.category.capitalize : 'N/A' %></p>
        <p class="text-3xl text-indigo-600 font-bold mb-6">
          ₹<%= @listing.price_per_day %>
          <span class="text-sm text-gray-500 font-normal">/ day</span>
        </p>

        <div class="mb-6">
          <h3 class="font-semibold text-gray-900 mb-2">Description</h3>
          <p class="text-gray-700 leading-relaxed"><%= @listing.description %></p>
        </div>

        <div class="mb-6 space-y-2">
          <div class="flex items-center text-gray-600">
            <svg class="w-5 h-5 mr-2 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
            </svg>
            <span class="font-medium">Listed by:</span>
            <span class="ml-2"><%= @listing.user&.name || 'Unknown' %></span>
          </div>
          <div class="flex items-center text-gray-600">
            <svg class="w-5 h-5 mr-2 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <span class="font-medium">Status:</span>
            <span class="ml-2 px-2 py-1 rounded-full text-xs font-medium <%= @listing.available? ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' %>">
              <%= @listing.status&.capitalize || 'Unknown' %>
            </span>
          </div>
        </div>

        <% if user_signed_in? && @listing.user != current_user && @listing.available? %>
          <div class="border-t pt-6">
            <h3 class="font-semibold text-gray-900 mb-4">Rent this outfit</h3>
            <%= form_with model: [@listing, @rental], local: true, class: "space-y-4", id: "rental-form" do |form| %>
              <div class="grid grid-cols-2 gap-4">
                <div>
                  <%= form.label :start_date, "Start Date", class: "block text-sm font-medium text-gray-700 mb-1" %>
                  <%= form.date_field :start_date, min: Date.today, class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500", id: "start-date", required: true %>
                </div>
                <div>
                  <%= form.label :end_date, "End Date", class: "block text-sm font-medium text-gray-700 mb-1" %>
                  <%= form.date_field :end_date, min: Date.today, class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500", id: "end-date", required: true %>
                </div>
              </div>

              <!-- Price Summary -->
              <div id="price-summary" class="hidden bg-gray-50 rounded-lg p-4 border border-gray-200">
                <div class="space-y-2">
                  <div class="flex justify-between text-sm">
                    <span class="text-gray-600">Price per day:</span>
                    <span class="font-medium">₹<%= @listing.price_per_day %></span>
                  </div>
                  <div class="flex justify-between text-sm">
                    <span class="text-gray-600">Duration:</span>
                    <span class="font-medium" id="duration-days">0 days</span>
                  </div>
                  <div class="flex justify-between text-lg font-bold pt-2 border-t">
                    <span class="text-gray-900">Total:</span>
                    <span class="text-indigo-600" id="total-price">₹0</span>
                  </div>
                </div>
              </div>

              <!-- Error Message -->
              <div id="date-error" class="hidden bg-red-50 border border-red-200 rounded-md p-3">
                <p class="text-red-700 text-sm" id="error-message"></p>
              </div>

              <div class="pt-2">
                <%= form.submit "Request to Rent", id: "submit-rental", class: "w-full bg-indigo-600 text-white px-6 py-3 rounded-md font-semibold hover:bg-indigo-700 transition cursor-pointer" %>
              </div>
            <% end %>
          </div>

          <script>
            document.addEventListener('DOMContentLoaded', function() {
              const startDateInput = document.getElementById('start-date');
              const endDateInput = document.getElementById('end-date');
              const priceSummary = document.getElementById('price-summary');
              const durationDays = document.getElementById('duration-days');
              const totalPrice = document.getElementById('total-price');
              const dateError = document.getElementById('date-error');
              const errorMessage = document.getElementById('error-message');
              const pricePerDay = <%= @listing.price_per_day %>;

              function calculatePrice() {
                const startDate = new Date(startDateInput.value);
                const endDate = new Date(endDateInput.value);

                // Reset
                dateError.classList.add('hidden');
                priceSummary.classList.add('hidden');

                if (startDateInput.value && endDateInput.value) {
                  if (endDate < startDate) {
                    errorMessage.textContent = "End date must be after start date";
                    dateError.classList.remove('hidden');
                    return;
                  }

                  const today = new Date();
                  today.setHours(0, 0, 0, 0);
                  if (startDate < today) {
                    errorMessage.textContent = "Start date cannot be in the past";
                    dateError.classList.remove('hidden');
                    return;
                  }

                  const days = Math.ceil((endDate - startDate) / (1000 * 60 * 60 * 24)) + 1;
                  const total = days * pricePerDay;

                  durationDays.textContent = days + " day" + (days > 1 ? "s" : "");
                  totalPrice.textContent = "₹" + total;
                  priceSummary.classList.remove('hidden');
                }
              }

              startDateInput.addEventListener('change', calculatePrice);
              endDateInput.addEventListener('change', calculatePrice);
            });
          </script>
        <% elsif @listing.user == current_user %>
          <div class="border-t pt-6">
            <h3 class="font-semibold text-gray-900 mb-4">Manage Listing</h3>
            <div class="space-y-2">
              <%= link_to "Edit Listing", edit_listing_path(@listing), class: "w-full text-center bg-gray-600 text-white px-6 py-3 rounded-md font-semibold hover:bg-gray-700 transition block" %>
              <%= button_to "Delete Listing", listing_path(@listing), method: :delete,
                  class: "w-full bg-red-600 text-white px-6 py-3 rounded-md font-semibold hover:bg-red-700 transition cursor-pointer",
                  data: { confirm_button: true, confirm_message: "Are you sure you want to delete this listing? This action cannot be undone.", confirm_title: "Delete Listing?", method: "delete" } %>
            </div>
          </div>
        <% elsif !@listing.available? %>
          <div class="border-t pt-6">
            <p class="text-red-600 font-medium flex items-center">
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              This listing is currently unavailable.
            </p>
          </div>
        <% end %>

        <% if !user_signed_in? %>
          <div class="border-t pt-6 mt-6">
            <p class="text-gray-600 text-center mb-4">Sign in to rent this outfit</p>
            <div class="flex space-x-2">
              <%= link_to "Login", new_user_session_path, class: "flex-1 text-center bg-indigo-600 text-white px-6 py-3 rounded-md font-semibold hover:bg-indigo-700 transition block" %>
              <%= link_to "Sign Up", new_user_registration_path, class: "flex-1 text-center bg-white border border-gray-300 text-gray-700 px-6 py-3 rounded-md font-semibold hover:bg-gray-50 transition block" %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>

</div>
