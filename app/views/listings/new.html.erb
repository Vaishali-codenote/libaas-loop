<div class="max-w-2xl mx-auto px-4 py-8">
  <div class="mb-6">
    <%= link_to "← Back to Listings", listings_path, class: "text-indigo-600 hover:text-indigo-800 flex items-center" %>
  </div>

  <div class="bg-white rounded-lg shadow-lg p-8">
    <h1 class="text-2xl font-bold text-gray-900 mb-6">Create New Listing</h1>

    <%= form_with model: @listing, local: true, class: "space-y-6", html: { multipart: true } do |form| %>
      <div>
        <%= form.label :title, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.text_field :title, class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500", placeholder: "e.g., Beautiful Red Lehenga" %>
      </div>

      <div>
        <%= form.label :description, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.text_area :description, rows: 4, class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500", placeholder: "Describe your outfit..." %>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <%= form.label :category, class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= form.select :category, , { prompt: "Select category" }, class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
        </div>

        <div>
          <%= form.label :price_per_day, "Price per Day (₹)", class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= form.number_field :price_per_day, step: 0.01, min: 0, class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500", placeholder: "500" %>
        </div>
      </div>

      <div>
        <%= form.label :image_upload, "Image", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.file_field :image_upload, accept: ".jpg,.jpeg,.png,.webp,.svg,image/*", class: "w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
        <p class="text-xs text-gray-500 mt-1">Optional. If not uploaded, default category image is used.</p>
      </div>

      <div class="flex space-x-4 pt-4">
        <%= form.submit "Create Listing", class: "flex-1 bg-indigo-600 text-white px-6 py-3 rounded-md font-semibold hover:bg-indigo-700 transition cursor-pointer" %>
        <%= link_to "Cancel", listings_path, class: "flex-1 text-center bg-gray-300 text-gray-700 px-6 py-3 rounded-md font-semibold hover:bg-gray-400 transition block" %>
      </div>
    <% end %>
  </div>
</div>
