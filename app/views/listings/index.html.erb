<div class="max-w-7xl mx-auto">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-3xl font-bold text-gray-900">Browse Listings</h1>
    <% if user_signed_in? %>
      <%= link_to "Create Listing", new_listing_path, class: "bg-indigo-600 text-white px-6 py-3 rounded-md font-semibold hover:bg-indigo-700 transition" %>
    <% end %>
  </div>

  <% if @categories.any? %>
    <div class="mb-6 flex flex-wrap gap-2">
      <span class="text-gray-600 font-medium">Categories:</span>
      <% @categories.each do |category| %>
        <span class="bg-gray-200 text-gray-700 px-3 py-1 rounded-full text-sm"><%= category %></span>
      <% end %>
    </div>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <% @listings.each do |listing| %>
      <div class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition">
        <% if listing.images.attached? %>
          <%= image_tag listing.images.first, class: "w-full h-48 object-cover" %>
        <% else %>
          <div class="w-full h-48 bg-gray-200 flex items-center justify-center">
            <span class="text-gray-400">No image</span>
          </div>
        <% end %>
        <div class="p-4">
          <h3 class="font-semibold text-lg mb-2"><%= listing.title %></h3>
          <p class="text-gray-600 text-sm mb-2"><%= listing.category %></p>
          <p class="text-indigo-600 font-bold">₹<%= listing.price_per_day %> / day</p>
          <p class="text-gray-500 text-sm mt-2">by <%= listing.user.name %></p>
          <%= link_to "View Details", listing_path(listing), class: "mt-3 block text-center bg-indigo-600 text-white px-4 py-2 rounded-md hover:bg-indigo-700 transition" %>
        </div>
      </div>
    <% end %>
  </div>

  <% if @listings.empty? %>
    <div class="text-center py-12">
      <p class="text-gray-500 text-lg mb-4">No listings available yet.</p>
      <% if user_signed_in? %>
        <%= link_to "Create the first listing", new_listing_path, class: "text-indigo-600 hover:text-indigo-800 font-semibold" %>
      <% end %>
    </div>
  <% end %>
</div>
