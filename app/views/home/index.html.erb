<div class="max-w-7xl mx-auto">
  <%= turbo_stream_from "listings" %>
  <!-- Hero Section -->
  <div class="bg-gradient-to-r from-indigo-600 to-purple-600 rounded-lg shadow-lg p-12 mb-8 text-white">
    <h1 class="text-5xl font-bold mb-4">LibaasLoop</h1>
    <p class="text-xl mb-6">Peer-to-peer ethnic wear rental marketplace</p>
    <p class="text-lg opacity-90 mb-8">Rent beautiful traditional outfits or list your own to share with the community</p>
    <div class="flex space-x-4">
      <% if user_signed_in? %>
        <%= link_to "List Your Outfit", new_listing_path, class: "bg-white text-indigo-600 px-6 py-3 rounded-md font-semibold hover:bg-gray-100 transition" %>
        <%= link_to "Browse Listings", listings_path, class: "border-2 border-white text-white px-6 py-3 rounded-md font-semibold hover:bg-white hover:text-indigo-600 transition" %>
      <% else %>
        <%= link_to "Get Started", new_user_registration_path, class: "bg-white text-indigo-600 px-6 py-3 rounded-md font-semibold hover:bg-gray-100 transition" %>
        <%= link_to "Browse Listings", listings_path, class: "border-2 border-white text-white px-6 py-3 rounded-md font-semibold hover:bg-white hover:text-indigo-600 transition" %>
      <% end %>
    </div>
  </div>

  <!-- Featured Listings -->
  <div class="mb-8">
    <h2 class="text-2xl font-bold text-gray-900 mb-6">Featured Listings</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% @featured_listings.each do |listing| %>
        <div id="<%= dom_id(listing) %>" class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition">
          <%= image_tag listing_image_source(listing), class: "w-full h-48 object-cover" %>
          <div class="p-4">
            <h3 class="font-semibold text-lg mb-2"><%= listing.title %></h3>
            <p class="text-gray-600 text-sm mb-2"><%= listing.category %></p>
            <p class="text-indigo-600 font-bold">₹<%= listing.price_per_day %> / day</p>
            <p class="text-gray-500 text-sm mt-2">by <%= listing.user.name %></p>
            <%= link_to "View Details", listing_path(listing), class: "mt-3 block text-center bg-indigo-600 text-white px-4 py-2 rounded-md hover:bg-indigo-700 transition" %>
          </div>
        </div>
      <% end %>
    </div>
    <% if @featured_listings.empty? %>
      <p class="text-gray-500 text-center py-8">No listings yet. Be the first to list an outfit!</p>
    <% end %>
  </div>

  <!-- How It Works -->
  <div class="bg-gray-100 rounded-lg p-8 mb-8">
    <h2 class="text-2xl font-bold text-gray-900 mb-6 text-center">How It Works</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="text-center">
        <div class="bg-indigo-600 text-white w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4 text-2xl font-bold">1</div>
        <h3 class="font-semibold text-lg mb-2">Browse or List</h3>
        <p class="text-gray-600">Explore beautiful ethnic wear or list your own outfits</p>
      </div>
      <div class="text-center">
        <div class="bg-indigo-600 text-white w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4 text-2xl font-bold">2</div>
        <h3 class="font-semibold text-lg mb-2">Request & Approve</h3>
        <p class="text-gray-600">Send rental requests and get approval from owners</p>
      </div>
      <div class="text-center">
        <div class="bg-indigo-600 text-white w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4 text-2xl font-bold">3</div>
        <h3 class="font-semibold text-lg mb-2">Wear & Return</h3>
        <p class="text-gray-600">Enjoy the outfit and return it when done</p>
      </div>
    </div>
  </div>
</div>
