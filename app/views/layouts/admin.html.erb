<!DOCTYPE html>
<html>
  <head>
    <title>Admin - LibaasLoop</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-100 h-screen flex overflow-hidden">
    <aside class="w-64 bg-indigo-900 text-white flex flex-col">
      <div class="p-6 border-b border-indigo-800">
        <%= link_to "LibaasLoop Admin", admin_dashboard_path, class: "text-2xl font-bold" %>
      </div>
      <nav class="flex-1 px-4 py-4 space-y-2 overflow-y-auto">
        <%= link_to "Dashboard", admin_dashboard_path, class: "block px-4 py-2 rounded hover:bg-indigo-800 transition #{current_page?(admin_dashboard_path) ? 'bg-indigo-800' : ''}" %>
        <%= link_to "Users", admin_users_path, class: "block px-4 py-2 rounded hover:bg-indigo-800 transition #{request.path.start_with?('/admin/users') ? 'bg-indigo-800' : ''}" %>
        <%= link_to "Listings", admin_listings_path, class: "block px-4 py-2 rounded hover:bg-indigo-800 transition #{request.path.start_with?('/admin/listings') ? 'bg-indigo-800' : ''}" %>
        <%= link_to "Rentals", admin_rentals_path, class: "block px-4 py-2 rounded hover:bg-indigo-800 transition #{request.path.start_with?('/admin/rentals') ? 'bg-indigo-800' : ''}" %>
        <%= link_to "Categories", admin_categories_path, class: "block px-4 py-2 rounded hover:bg-indigo-800 transition #{request.path.start_with?('/admin/categories') ? 'bg-indigo-800' : ''}" %>
        <%= link_to "Reports", admin_reports_path, class: "block px-4 py-2 rounded hover:bg-indigo-800 transition #{current_page?(admin_reports_path) ? 'bg-indigo-800' : ''}" %>
      </nav>
      <div class="p-4 border-t border-indigo-800">
        <%= link_to root_path, class: "block px-4 py-2 rounded hover:bg-indigo-800 transition text-sm", data: { turbo: false } do %>
          Back to Site
        <% end %>
        <%= button_to "Logout", admin_logout_path, method: :delete, class: "w-full text-left px-4 py-2 rounded hover:bg-indigo-800 transition mt-2 text-sm" %>
      </div>
    </aside>

    <main class="flex-1 flex flex-col overflow-hidden">
      <header class="bg-white shadow-sm border-b px-8 py-4 flex justify-between items-center">
        <div class="flex items-center gap-3">
          <button type="button" onclick="window.history.length > 1 ? history.back() : window.location.assign('<%= admin_dashboard_path %>')" class="text-sm text-gray-600 hover:text-gray-900 border border-gray-300 rounded-md px-3 py-1.5">
            Back
          </button>
          <h2 class="text-xl font-semibold text-gray-800"><%= yield :title %></h2>
        </div>
        <div class="flex items-center gap-4">
          <div class="relative">
            <input type="text" placeholder="Quick search" class="border border-gray-300 rounded-md px-3 py-2 text-sm w-56">
          </div>
          <button class="relative p-2 rounded-md border border-gray-300 text-gray-600" type="button" aria-label="Notifications">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.4-1.4A2 2 0 0118 14.2V11a6 6 0 10-12 0v3.2a2 2 0 01-.6 1.4L4 17h5m6 0a3 3 0 11-6 0m6 0H9"></path>
            </svg>
          </button>
          <span class="text-sm text-gray-600">Admin: <%= current_user.name %></span>
        </div>
      </header>

      <div class="flex-1 overflow-y-auto p-8">
        <% if notice %>
          <div class="mb-4 bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative" role="alert">
            <%= notice %>
          </div>
        <% end %>
        <% if alert %>
          <div class="mb-4 bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative" role="alert">
            <%= alert %>
          </div>
        <% end %>
        <%= yield %>
      </div>
    </main>
  </body>
</html>
