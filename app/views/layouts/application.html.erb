<!DOCTYPE html>
<html>
  <head>
    <title>LibaasLoop - Ethnic Wear Rental Marketplace</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-50">
    <nav class="bg-white shadow-sm border-b">
      <div class="container mx-auto px-4">
        <div class="flex justify-between items-center h-16">
          <div class="flex items-center">
            <%= link_to "LibaasLoop", root_path, class: "text-xl font-bold text-indigo-600" %>
            <div class="ml-10 flex space-x-4">
              <%= link_to "Browse", listings_path, class: "text-gray-600 hover:text-gray-900" %>
              <% if user_signed_in? %>
                <%= link_to "My Listings", my_listings_path, class: "text-gray-600 hover:text-gray-900" %>
                <%= link_to "My Rentals", my_rentals_path, class: "text-gray-600 hover:text-gray-900" %>
              <% end %>
            </div>
          </div>
          <div class="flex items-center space-x-4">
            <% if user_signed_in? %>
              <span class="text-gray-600">Hello, <%= current_user.name %></span>
              <% if current_user.admin? %>
                <%= link_to "Admin", admin_dashboard_path, class: "text-red-600 hover:text-red-900 font-medium" %>
              <% end %>
              <%= button_to "Logout", destroy_user_session_path, method: :delete, class: "text-gray-600 hover:text-gray-900" %>
            <% else %>
              <%= link_to "Login", new_user_session_path, class: "text-gray-600 hover:text-gray-900" %>
              <%= link_to "Sign Up", new_user_registration_path, class: "bg-indigo-600 text-white px-4 py-2 rounded-md hover:bg-indigo-700" %>
            <% end %>
          </div>
        </div>
      </div>
    </nav>

    <% if notice %>
      <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative container mx-auto mt-4" role="alert">
        <%= notice %>
      </div>
    <% end %>
    
    <% if alert %>
      <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative container mx-auto mt-4" role="alert">
        <%= alert %>
      </div>
    <% end %>

    <main class="container mx-auto mt-6 px-4">
      <%= yield %>
    </main>
  </body>
</html>
