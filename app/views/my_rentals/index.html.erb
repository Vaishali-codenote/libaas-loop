<div class="max-w-6xl mx-auto">
  <%= turbo_stream_from "rentals" %>
  <h1 class="text-3xl font-bold text-gray-900 mb-6">My Rentals</h1>

  <!-- Rentals as Renter -->
  <div class="mb-8">
    <h2 class="text-xl font-semibold text-gray-800 mb-4">Rentals I've Requested</h2>
    <div class="bg-white rounded-lg shadow overflow-hidden">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Listing</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Owner/Renter</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Dates</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
          </tr>
        </thead>
        <tbody id="rentals_as_renter" class="bg-white divide-y divide-gray-200">
          <%= render partial: "rentals/rental", collection: @rentals_as_renter, as: :rental %>
        </tbody>
      </table>
      <% if @rentals_as_renter.empty? %>
        <div id="no_rentals_as_renter" class="p-6 text-center text-gray-500">No rental requests yet.</div>
      <% end %>
    </div>
  </div>

  <!-- Rentals as Owner -->
  <div>
    <h2 class="text-xl font-semibold text-gray-800 mb-4">Rentals for My Listings</h2>
    <div class="bg-white rounded-lg shadow overflow-hidden">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Listing</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Owner/Renter</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Dates</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
          </tr>
        </thead>
        <tbody id="rentals_as_owner" class="bg-white divide-y divide-gray-200">
          <%= render partial: "rentals/rental", collection: @rentals_as_owner, as: :rental %>
        </tbody>
      </table>
      <% if @rentals_as_owner.empty? %>
        <div id="no_rentals_as_owner" class="p-6 text-center text-gray-500">No rental requests for your listings yet.</div>
      <% end %>
    </div>
  </div>
</div>
