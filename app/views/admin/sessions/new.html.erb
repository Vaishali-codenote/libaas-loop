<div class="min-h-[80vh] flex items-center justify-center px-4">
  <div class="w-full max-w-md bg-white rounded-lg shadow p-8">
    <h1 class="text-2xl font-bold text-gray-900 mb-6">Admin Login</h1>

    <%= form_with url: admin_login_path, method: :post, local: true, class: "space-y-4" do |form| %>
      <div>
        <%= label_tag :email, "Email", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= email_field_tag :email, params[:email], class: "w-full px-3 py-2 border border-gray-300 rounded-md" %>
      </div>

      <div>
        <%= label_tag :password, "Password", class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= password_field_tag :password, nil, class: "w-full px-3 py-2 border border-gray-300 rounded-md" %>
      </div>

      <%= submit_tag "Login as Admin", class: "w-full bg-indigo-600 text-white px-4 py-2 rounded-md font-semibold hover:bg-indigo-700 cursor-pointer" %>
    <% end %>
  </div>
</div>
