<div class="max-w-7xl mx-auto">
  <h1 class="text-3xl font-bold text-gray-900 mb-6">Manage Listings</h1>

  <div class="bg-white rounded-lg shadow overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Image</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Title</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Category</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Price</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Owner</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% @listings.each do |listing| %>
          <tr>
            <td class="px-6 py-4 whitespace-nowrap">
              <% if listing.images.attached? %>
                <%= image_tag listing.images.first.variant(resize_to_limit: [80, 80]), class: "w-16 h-16 object-cover rounded" %>
              <% else %>
                <div class="w-16 h-16 bg-gray-200 rounded flex items-center justify-center">
                  <span class="text-gray-400 text-xs">No img</span>
                </div>
              <% end %>
            </td>
            <td class="px-6 py-4">
              <div class="text-sm font-medium text-gray-900"><%= listing.title %></div>
            </td>
            <td class="px-6 py-4">
              <div class="text-sm text-gray-500"><%= listing.category %></div>
            </td>
            <td class="px-6 py-4">
              <div class="text-sm text-gray-900">₹<%= listing.price_per_day %></div>
            </td>
            <td class="px-6 py-4">
              <div class="text-sm text-gray-500"><%= listing.user.name %></div>
            </td>
            <td class="px-6 py-4">
              <span class="px-2 py-1 text-xs font-medium rounded-full <%= listing.available? ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' %>">
                <%= listing.status %>
              </span>
            </td>
            <td class="px-6 py-4 text-sm font-medium">
              <%= link_to "View", admin_listing_path(listing), class: "text-indigo-600 hover:text-indigo-900 mr-3" %>
              <%= button_to "Delete", admin_listing_path(listing), method: :delete, class: "text-red-600 hover:text-red-900 inline", data: { confirm: "Are you sure?" } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <% if @listings.respond_to?(:total_pages) %>
    <div class="mt-6">
      <%= paginate @listings %>
    </div>
  <% end %>
</div>
