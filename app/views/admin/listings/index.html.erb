<% content_for :title, "Listings" %>

<div class="max-w-7xl mx-auto">
  <div class="bg-white rounded-lg shadow overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Title</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Owner</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Category</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Approval</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Actions</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% @listings.each do |listing| %>
          <tr>
            <td class="px-6 py-4 text-sm font-medium text-gray-900"><%= listing.title %></td>
            <td class="px-6 py-4 text-sm text-gray-500"><%= listing.user.name %></td>
            <td class="px-6 py-4 text-sm text-gray-500"><%= listing.category %></td>
            <td class="px-6 py-4 text-sm text-gray-500"><%= listing.approval_status %></td>
            <td class="px-6 py-4 text-sm text-gray-500"><%= listing.status %></td>
            <td class="px-6 py-4 text-sm space-x-2">
              <%= link_to "View", admin_listing_path(listing), class: "text-indigo-600" %>
              <%= link_to "Edit", edit_admin_listing_path(listing), class: "text-gray-700" %>
              <%= button_to "Delete", admin_listing_path(listing), method: :delete, 
                  class: "text-red-600 inline",
                  data: { confirm_button: true, confirm_message: "Are you sure you want to delete '#{listing.title}'?", confirm_title: "Delete Listing?", method: "delete" } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
