<% content_for :title, "Edit Listing" %>

<div class="max-w-2xl mx-auto bg-white rounded-lg shadow p-6">
  <%= form_with model: [:admin, @listing], local: true, class: "space-y-4" do |form| %>
    <div>
      <%= form.label :title, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.text_field :title, class: "w-full border border-gray-300 rounded px-3 py-2" %>
    </div>
    <div>
      <%= form.label :description, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.text_area :description, rows: 4, class: "w-full border border-gray-300 rounded px-3 py-2" %>
    </div>
    <div class="grid grid-cols-2 gap-4">
      <div>
        <%= form.label :category, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.text_field :category, class: "w-full border border-gray-300 rounded px-3 py-2" %>
      </div>
      <div>
        <%= form.label :price_per_day, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.number_field :price_per_day, step: 0.01, class: "w-full border border-gray-300 rounded px-3 py-2" %>
      </div>
    </div>
    <div class="grid grid-cols-2 gap-4">
      <div>
        <%= form.label :status, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.select :status, Listing.statuses.keys.map { |s| [s.titleize, s] }, {}, class: "w-full border border-gray-300 rounded px-3 py-2" %>
      </div>
      <div>
        <%= form.label :approval_status, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.select :approval_status, Listing.approval_statuses.keys.map { |s| [s.titleize, s] }, {}, class: "w-full border border-gray-300 rounded px-3 py-2" %>
      </div>
    </div>
    <%= form.submit "Update Listing", class: "bg-indigo-600 text-white px-4 py-2 rounded" %>
  <% end %>
</div>
