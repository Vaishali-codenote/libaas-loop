<div class="max-w-4xl mx-auto">
  <div class="mb-6">
    <%= link_to "← Back to Listings", admin_listings_path, class: "text-indigo-600 hover:text-indigo-800" %>
  </div>

  <div class="bg-white rounded-lg shadow-lg overflow-hidden">
    <div class="grid grid-cols-1 md:grid-cols-2">
      <div class="bg-gray-100">
        <% if @listing.images.attached? %>
          <%= image_tag @listing.images.first.variant(resize_to_limit: [600, 600]), class: "w-full h-96 object-cover" %>
        <% else %>
          <div class="w-full h-96 bg-gray-200 flex items-center justify-center">
            <span class="text-gray-400">No image available</span>
          </div>
        <% end %>
      </div>

      <div class="p-8">
        <h1 class="text-2xl font-bold text-gray-900 mb-2"><%= @listing.title %></h1>
        <p class="text-gray-600 mb-4"><%= @listing.category %></p>
        <p class="text-2xl text-indigo-600 font-bold mb-6">₹<%= @listing.price_per_day %> <span class="text-sm text-gray-500">/ day</span></p>

        <dl class="space-y-3 mb-6">
          <div>
            <dt class="font-semibold text-gray-700">Description</dt>
            <dd class="text-gray-900"><%= @listing.description %></dd>
          </div>

          <div>
            <dt class="font-semibold text-gray-700">Owner</dt>
            <dd class="text-gray-900"><%= @listing.user.name %></dd>
          </div>

          <div>
            <dt class="font-semibold text-gray-700">Status</dt>
            <dd>
              <span class="px-2 py-1 text-xs font-medium rounded-full <%= @listing.available? ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' %>">
                <%= @listing.status %>
              </span>
            </dd>
          </div>

          <div>
            <dt class="font-semibold text-gray-700">Created</dt>
            <dd class="text-gray-900"><%= @listing.created_at.strftime("%B %d, %Y") %></dd>
          </div>
        </dl>

        <%= button_to "Delete Listing", admin_listing_path(@listing), method: :delete, class: "w-full bg-red-600 text-white px-6 py-3 rounded-md font-semibold hover:bg-red-700 transition cursor-pointer", data: { confirm: "Are you sure you want to delete this listing?" } %>
      </div>
    </div>
  </div>
</div>
