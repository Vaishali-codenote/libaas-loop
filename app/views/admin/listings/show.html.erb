<% content_for :title, "Listing Details" %>

<div class="max-w-6xl mx-auto space-y-6">
  <div class="bg-white rounded-lg shadow p-6">
    <div class="flex justify-between items-start">
      <div>
        <h1 class="text-2xl font-bold text-gray-900"><%= @listing.title %></h1>
        <p class="text-gray-500"><%= @listing.category %> | ₹<%= @listing.price_per_day %>/day</p>
        <p class="text-sm text-gray-500 mt-1">Approval: <%= @listing.approval_status %>, Status: <%= @listing.status %></p>
      </div>
      <div class="flex flex-wrap gap-2">
        <%= button_to "Approve", approve_admin_listing_path(@listing), method: :patch, class: "bg-green-600 text-white px-3 py-2 rounded" %>
        <%= button_to "Reject", reject_admin_listing_path(@listing), method: :patch, class: "bg-yellow-600 text-white px-3 py-2 rounded" %>
        <%= link_to "Edit", edit_admin_listing_path(@listing), class: "bg-indigo-600 text-white px-3 py-2 rounded" %>
        <%= button_to "Delete", admin_listing_path(@listing), method: :delete, 
            class: "bg-red-600 text-white px-3 py-2 rounded",
            data: { confirm_button: true, confirm_message: "Are you sure you want to delete this listing?", confirm_title: "Delete Listing?" } %>
      </div>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow p-6">
    <h2 class="font-semibold text-gray-900 mb-3">Rental History</h2>
    <table class="min-w-full divide-y divide-gray-200">
      <thead>
        <tr>
          <th class="px-3 py-2 text-left text-xs text-gray-500 uppercase">Renter</th>
          <th class="px-3 py-2 text-left text-xs text-gray-500 uppercase">Dates</th>
          <th class="px-3 py-2 text-left text-xs text-gray-500 uppercase">Status</th>
          <th class="px-3 py-2 text-left text-xs text-gray-500 uppercase">Amount</th>
        </tr>
      </thead>
      <tbody>
        <% @rental_history.each do |rental| %>
          <tr class="border-t">
            <td class="px-3 py-2 text-sm"><%= rental.renter.name %></td>
            <td class="px-3 py-2 text-sm"><%= rental.start_date %> - <%= rental.end_date %></td>
            <td class="px-3 py-2 text-sm"><%= rental.status %></td>
            <td class="px-3 py-2 text-sm">₹<%= rental.total_price %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
