<% content_for :title, "Categories" %>

<div class="max-w-5xl mx-auto space-y-4">
  <div class="flex justify-between items-center">
    <h1 class="text-2xl font-bold text-gray-900">Categories</h1>
    <%= link_to "Add Category", new_admin_category_path, class: "bg-indigo-600 text-white px-4 py-2 rounded" %>
  </div>

  <div class="bg-white rounded-lg shadow overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Name</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Slug</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Actions</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% @categories.each do |category| %>
          <tr>
            <td class="px-6 py-4 text-sm"><%= category.name %></td>
            <td class="px-6 py-4 text-sm text-gray-500"><%= category.slug %></td>
            <td class="px-6 py-4 text-sm"><%= category.active? ? 'Active' : 'Disabled' %></td>
            <td class="px-6 py-4 text-sm space-x-2">
              <%= link_to "Edit", edit_admin_category_path(category), class: "text-indigo-600" %>
              <%= button_to(category.active? ? "Disable" : "Enable", toggle_status_admin_category_path(category), method: :patch, class: "text-yellow-700 inline") %>
              <%= button_to "Delete", admin_category_path(category), method: :delete, 
                  class: "text-red-600 inline",
                  data: { confirm_button: true, confirm_message: "Are you sure you want to delete '#{category.name}' category?", confirm_title: "Delete Category?" } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
