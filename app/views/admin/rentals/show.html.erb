<% content_for :title, "Rental Details" %>

<div class="max-w-4xl mx-auto space-y-6">
  <div class="bg-white rounded-lg shadow p-6">
    <h1 class="text-2xl font-bold text-gray-900 mb-4"><%= @rental.listing.title %></h1>
    <p class="text-gray-600 mb-1">Renter: <%= @rental.renter.name %> | Owner: <%= @rental.owner.name %></p>
    <p class="text-gray-600 mb-1">Dates: <%= @rental.start_date %> to <%= @rental.end_date %></p>
    <p class="text-gray-600 mb-1">Status: <%= @rental.status %></p>
    <p class="text-gray-600">Refund: <%= @rental.refund_issued? ? @rental.refund_issued_at.strftime('%Y-%m-%d %H:%M') : 'Not issued' %></p>
  </div>

  <div class="bg-white rounded-lg shadow p-6 space-y-4">
    <%= form_with model: [:admin, @rental], local: true do |form| %>
      <div>
        <%= form.label :status, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.select :status, Rental.statuses.keys.map { |s| [s.titleize, s] }, {}, class: "w-full border border-gray-300 rounded px-3 py-2" %>
      </div>
      <%= form.submit "Update Rental", class: "mt-3 bg-indigo-600 text-white px-4 py-2 rounded" %>
    <% end %>

    <div class="flex flex-wrap gap-2 pt-3 border-t">
      <%= button_to "Cancel Rental", cancel_admin_rental_path(@rental), method: :patch, class: "bg-yellow-600 text-white px-3 py-2 rounded" %>
      <%= button_to "Force Complete", force_complete_admin_rental_path(@rental), method: :patch, class: "bg-green-600 text-white px-3 py-2 rounded" %>
      <% unless @rental.refund_issued? %>
        <%= button_to "Issue Refund", issue_refund_admin_rental_path(@rental), method: :patch, class: "bg-red-600 text-white px-3 py-2 rounded" %>
      <% end %>
    </div>
  </div>
</div>
