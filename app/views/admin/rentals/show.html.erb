<div class="max-w-4xl mx-auto">
  <div class="mb-6">
    <%= link_to "← Back to Rentals", admin_rentals_path, class: "text-indigo-600 hover:text-indigo-800" %>
  </div>

  <div class="bg-white rounded-lg shadow-lg p-8">
    <h1 class="text-2xl font-bold text-gray-900 mb-6">Rental Details</h1>

    <dl class="space-y-4 mb-8">
      <div>
        <dt class="font-semibold text-gray-700">Listing</dt>
        <dd class="text-gray-900"><%= @rental.listing.title %></dd>
      </div>

      <div>
        <dt class="font-semibold text-gray-700">Renter</dt>
        <dd class="text-gray-900"><%= @rental.renter.name %> (<%= @rental.renter.email %>)</dd>
      </div>

      <div>
        <dt class="font-semibold text-gray-700">Owner</dt>
        <dd class="text-gray-900"><%= @rental.owner.name %> (<%= @rental.owner.email %>)</dd>
      </div>

      <div>
        <dt class="font-semibold text-gray-700">Rental Period</dt>
        <dd class="text-gray-900"><%= @rental.start_date %> to <%= @rental.end_date %></dd>
      </div>

      <div>
        <dt class="font-semibold text-gray-700">Duration</dt>
        <dd class="text-gray-900"><%= (@rental.end_date - @rental.start_date).to_i %> days</dd>
      </div>

      <div>
        <dt class="font-semibold text-gray-700">Total Price</dt>
        <dd class="text-gray-900 font-bold text-indigo-600">₹<%= @rental.total_price %></dd>
      </div>

      <div>
        <dt class="font-semibold text-gray-700">Status</dt>
        <dd>
          <span class="px-2 py-1 text-xs font-medium rounded-full <%= status_class(@rental.status) %>">
            <%= @rental.status %>
          </span>
        </dd>
      </div>

      <div>
        <dt class="font-semibold text-gray-700">Created</dt>
        <dd class="text-gray-900"><%= @rental.created_at.strftime("%B %d, %Y at %I:%M %p") %></dd>
      </div>

      <div>
        <dt class="font-semibold text-gray-700">Last Updated</dt>
        <dd class="text-gray-900"><%= @rental.updated_at.strftime("%B %d, %Y at %I:%M %p") %></dd>
      </div>
    </dl>

    <div class="border-t pt-6">
      <h3 class="font-semibold text-gray-900 mb-4">Update Rental Status</h3>
      <%= form_with model: [:admin, @rental], local: true, class: "space-y-4" do |form| %>
        <div>
          <%= form.label :status, class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= form.select :status, [["Pending", "pending"], ["Approved", "approved"], ["Active", "active"], ["Completed", "completed"], ["Rejected", "rejected"], ["Cancelled", "cancelled"]], {}, class: "w-full border-gray-300 rounded-md shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
        </div>
        <%= form.submit "Update Status", class: "bg-indigo-600 text-white px-6 py-3 rounded-md font-semibold hover:bg-indigo-700 transition cursor-pointer" %>
      <% end %>
    </div>
  </div>
</div>
