<% content_for :title, "Rentals" %>

<div class="max-w-7xl mx-auto space-y-4">
  <div class="bg-white rounded-lg shadow p-4">
    <p class="text-sm text-gray-600">Revenue from active/completed rentals: <span class="font-semibold text-indigo-700">₹<%= @total_revenue.to_i %></span></p>
  </div>

  <div class="bg-white rounded-lg shadow overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Listing</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Renter</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Owner</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Refund</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Actions</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% @rentals.each do |rental| %>
          <tr>
            <td class="px-6 py-4 text-sm font-medium text-gray-900"><%= rental.listing.title %></td>
            <td class="px-6 py-4 text-sm text-gray-500"><%= rental.renter.name %></td>
            <td class="px-6 py-4 text-sm text-gray-500"><%= rental.owner.name %></td>
            <td class="px-6 py-4 text-sm text-gray-500"><%= rental.status %></td>
            <td class="px-6 py-4 text-sm text-gray-500"><%= rental.refund_issued? ? 'Issued' : 'Not issued' %></td>
            <td class="px-6 py-4 text-sm">
              <%= link_to "View", admin_rental_path(rental), class: "text-indigo-600" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
