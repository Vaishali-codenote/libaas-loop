<div class="max-w-7xl mx-auto">
  <h1 class="text-3xl font-bold text-gray-900 mb-6">Manage Rentals</h1>

  <div class="bg-white rounded-lg shadow overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Listing</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Renter</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Owner</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Dates</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% @rentals.each do |rental| %>
          <tr>
            <td class="px-6 py-4">
              <div class="text-sm font-medium text-gray-900"><%= rental.listing.title %></div>
            </td>
            <td class="px-6 py-4">
              <div class="text-sm text-gray-500"><%= rental.renter.name %></div>
            </td>
            <td class="px-6 py-4">
              <div class="text-sm text-gray-500"><%= rental.owner.name %></div>
            </td>
            <td class="px-6 py-4">
              <div class="text-sm text-gray-500">
                <%= rental.start_date %> to <%= rental.end_date %>
              </div>
            </td>
            <td class="px-6 py-4">
              <span class="px-2 py-1 text-xs font-medium rounded-full <%= status_class(rental.status) %>">
                <%= rental.status %>
              </span>
            </td>
            <td class="px-6 py-4 text-sm font-medium">
              <%= link_to "View", admin_rental_path(rental), class: "text-indigo-600 hover:text-indigo-900 mr-3" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <% if @rentals.respond_to?(:total_pages) %>
    <div class="mt-6">
      <%= paginate @rentals %>
    </div>
  <% end %>
</div>
