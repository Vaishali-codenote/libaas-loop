<% content_for :title, "Dashboard" %>

<div class="max-w-7xl mx-auto space-y-8">
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-6">
    <div class="bg-white rounded-lg shadow p-6">
      <p class="text-sm text-gray-500">Total Users</p>
      <p class="text-3xl font-bold text-gray-900"><%= @total_users %></p>
    </div>
    <div class="bg-white rounded-lg shadow p-6">
      <p class="text-sm text-gray-500">Total Listings</p>
      <p class="text-3xl font-bold text-gray-900"><%= @total_listings %></p>
    </div>
    <div class="bg-white rounded-lg shadow p-6">
      <p class="text-sm text-gray-500">Total Active Rentals</p>
      <p class="text-3xl font-bold text-green-700"><%= @total_active_rentals %></p>
    </div>
    <div class="bg-white rounded-lg shadow p-6">
      <p class="text-sm text-gray-500">Pending Listings</p>
      <p class="text-3xl font-bold text-yellow-700"><%= @pending_listings_count %></p>
    </div>
    <div class="bg-white rounded-lg shadow p-6">
      <p class="text-sm text-gray-500">Total Revenue</p>
      <p class="text-3xl font-bold text-indigo-700">₹<%= @total_revenue.to_i %></p>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div class="bg-white rounded-lg shadow p-6">
      <h3 class="text-lg font-semibold text-gray-900 mb-4">Recently Registered Users</h3>
      <ul class="space-y-3">
        <% @recent_users.each do |user| %>
          <li class="flex justify-between items-center">
            <div>
              <p class="font-medium text-gray-900"><%= user.name %></p>
              <p class="text-sm text-gray-500"><%= user.email %></p>
            </div>
            <%= link_to "View", admin_user_path(user), class: "text-indigo-600 text-sm" %>
          </li>
        <% end %>
      </ul>
    </div>

    <div class="bg-white rounded-lg shadow p-6">
      <h3 class="text-lg font-semibold text-gray-900 mb-4">Recently Created Listings</h3>
      <ul class="space-y-3">
        <% @recent_listings.each do |listing| %>
          <li class="flex justify-between items-center">
            <div>
              <p class="font-medium text-gray-900"><%= listing.title %></p>
              <p class="text-sm text-gray-500"><%= listing.category %> by <%= listing.user.name %></p>
            </div>
            <%= link_to "View", admin_listing_path(listing), class: "text-indigo-600 text-sm" %>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
</div>
