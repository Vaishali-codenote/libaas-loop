<% content_for :title, "Edit User" %>

<div class="max-w-2xl mx-auto bg-white rounded-lg shadow p-6">
  <%= form_with model: [:admin, @user], local: true, class: "space-y-4" do |form| %>
    <div>
      <%= form.label :name, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.text_field :name, class: "w-full border border-gray-300 rounded-md px-3 py-2" %>
    </div>

    <div>
      <%= form.label :email, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.email_field :email, class: "w-full border border-gray-300 rounded-md px-3 py-2" %>
    </div>

    <div>
      <%= form.label :role, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.select :role, User.roles.keys.map { |r| [r.titleize, r] }, {}, class: "w-full border border-gray-300 rounded-md px-3 py-2" %>
    </div>

    <div class="flex items-center gap-2">
      <%= form.check_box :blocked %>
      <%= form.label :blocked, "Blocked" %>
    </div>

    <%= form.submit "Update User", class: "bg-indigo-600 text-white px-4 py-2 rounded" %>
  <% end %>
</div>
