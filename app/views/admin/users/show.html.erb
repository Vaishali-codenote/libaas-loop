<div class="max-w-4xl mx-auto">
  <div class="mb-6">
    <%= link_to "← Back to Users", admin_users_path, class: "text-indigo-600 hover:text-indigo-800" %>
  </div>

  <div class="bg-white rounded-lg shadow-lg p-8">
    <h1 class="text-2xl font-bold text-gray-900 mb-6">User Details</h1>

    <dl class="space-y-4">
      <div>
        <dt class="font-semibold text-gray-700">Name</dt>
        <dd class="text-gray-900"><%= @user.name %></dd>
      </div>

      <div>
        <dt class="font-semibold text-gray-700">Email</dt>
        <dd class="text-gray-900"><%= @user.email %></dd>
      </div>

      <div>
        <dt class="font-semibold text-gray-700">Role</dt>
        <dd>
          <span class="px-2 py-1 text-xs font-medium rounded-full <%= @user.admin? ? 'bg-red-100 text-red-800' : 'bg-gray-100 text-gray-800' %>">
            <%= @user.role %>
          </span>
        </dd>
      </div>

      <div>
        <dt class="font-semibold text-gray-700">Joined</dt>
        <dd class="text-gray-900"><%= @user.created_at.strftime("%B %d, %Y at %I:%M %p") %></dd>
      </div>

      <div>
        <dt class="font-semibold text-gray-700">Total Listings</dt>
        <dd class="text-gray-900"><%= @user.listings.count %></dd>
      </div>

      <div>
        <dt class="font-semibold text-gray-700">Total Rentals (as Renter)</dt>
        <dd class="text-gray-900"><%= @user.rentals_as_renter.count %></dd>
      </div>

      <div>
        <dt class="font-semibold text-gray-700">Total Rentals (as Owner)</dt>
        <dd class="text-gray-900"><%= @user.rentals_as_owner.count %></dd>
      </div>
    </dl>

    <div class="mt-8 pt-6 border-t">
      <% unless @user.admin? %>
        <%= button_to "Delete User", admin_user_path(@user), method: :delete, class: "bg-red-600 text-white px-6 py-3 rounded-md font-semibold hover:bg-red-700 transition cursor-pointer", data: { confirm: "Are you sure you want to delete this user? This action cannot be undone." } %>
      <% end %>
    </div>
  </div>
</div>
