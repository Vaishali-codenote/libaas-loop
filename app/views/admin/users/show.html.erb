<% content_for :title, "User Details" %>

<div class="max-w-6xl mx-auto space-y-6">
  <div class="bg-white rounded-lg shadow p-6">
    <div class="flex justify-between items-start">
      <div>
        <h1 class="text-2xl font-bold text-gray-900"><%= @user.name %></h1>
        <p class="text-gray-600"><%= @user.email %></p>
        <p class="text-sm text-gray-500 mt-1">Role: <%= @user.role %></p>
        <p class="text-sm text-gray-500">Total earnings: ₹<%= @total_earnings.to_i %></p>
      </div>
      <div class="flex flex-wrap gap-2 justify-end">
        <% if @user.blocked? %>
          <%= button_to "Unblock", unblock_admin_user_path(@user), method: :patch, class: "bg-green-600 text-white px-3 py-2 rounded" %>
        <% else %>
          <%= button_to "Block", block_admin_user_path(@user), method: :patch, class: "bg-yellow-600 text-white px-3 py-2 rounded" %>
        <% end %>
        <% unless @user.admin? %>
          <%= button_to "Promote to Admin", promote_admin_user_path(@user), method: :patch, class: "bg-indigo-600 text-white px-3 py-2 rounded" %>
        <% end %>
        <% unless @user == current_user %>
          <%= button_to "Delete User", admin_user_path(@user), method: :delete, 
              class: "bg-red-600 text-white px-3 py-2 rounded",
              data: { confirm_button: true, confirm_message: "Are you sure you want to delete this user? This action cannot be undone.", confirm_title: "Delete User?" } %>
        <% end %>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <div class="bg-white rounded-lg shadow p-6">
      <h2 class="font-semibold text-gray-900 mb-3">User Listings</h2>
      <ul class="space-y-2">
        <% @listings.each do |listing| %>
          <li class="flex justify-between text-sm">
            <span><%= listing.title %> (<%= listing.category %>)</span>
            <%= link_to "View", admin_listing_path(listing), class: "text-indigo-600" %>
          </li>
        <% end %>
      </ul>
    </div>

    <div class="bg-white rounded-lg shadow p-6">
      <h2 class="font-semibold text-gray-900 mb-3">User Rentals</h2>
      <ul class="space-y-2">
        <% @rentals.each do |rental| %>
          <li class="flex justify-between text-sm">
            <span><%= rental.listing.title %> - <%= rental.status %></span>
            <%= link_to "View", admin_rental_path(rental), class: "text-indigo-600" %>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
</div>
