<!DOCTYPE html>
<html>
  <head>
    <meta content='text/html; charset=UTF-8' http-equiv='Content-Type' />
  </head>
  <body style="font-family: Arial, sans-serif; line-height: 1.6; color: #333; max-width: 600px; margin: 0 auto; padding: 20px;">
    <div style="background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%); padding: 30px; text-align: center; border-radius: 10px 10px 0 0;">
      <h1 style="color: white; margin: 0; font-size: 24px;">LibaasLoop</h1>
      <p style="color: rgba(255,255,255,0.9); margin: 10px 0 0 0; font-size: 14px;">Ethnic Wear Rental Marketplace</p>
    </div>
    
    <div style="background: #ffffff; padding: 30px; border: 1px solid #e5e7eb; border-top: none; border-radius: 0 0 10px 10px;">
      <h2 style="color: #1f2937; margin-top: 0; font-size: 20px;">Forgot your password?</h2>
      
      <p style="color: #4b5563; font-size: 16px;">Hi <%= @resource.email %>,</p>
      
      <p style="color: #4b5563; font-size: 16px;">Someone has requested a link to change your password. You can do this by clicking the button below:</p>
      
      <div style="text-align: center; margin: 30px 0;">
        <a href="<%= edit_password_url(@resource, reset_password_token: @token) %>" 
           style="display: inline-block; background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%); color: #ffffff; text-decoration: none; padding: 14px 40px; border-radius: 8px; font-size: 16px; font-weight: bold; box-shadow: 0 4px 6px rgba(79, 70, 229, 0.3);">
          Change My Password
        </a>
      </div>
      
      <p style="color: #6b7280; font-size: 14px; text-align: center;">Or copy and paste this link into your browser:</p>
      <p style="background: #f3f4f6; padding: 10px; border-radius: 5px; font-size: 12px; word-break: break-all; text-align: center;">
        <%= edit_password_url(@resource, reset_password_token: @token) %>
      </p>
      
      <hr style="border: none; border-top: 1px solid #e5e7eb; margin: 25px 0;" />
      
      <p style="color: #6b7280; font-size: 14px; margin-bottom: 5px;"><strong>Link expires in:</strong> 6 hours</p>
      
      <p style="color: #6b7280; font-size: 14px; margin-top: 20px;">
        If you didn't request this, please ignore this email and your password will remain unchanged.
      </p>
      
      <p style="color: #6b7280; font-size: 14px; margin-top: 25px;">
        Best regards,<br />
        <strong style="color: #4f46e5;">The LibaasLoop Team</strong>
      </p>
    </div>
    
    <div style="text-align: center; padding: 20px; color: #9ca3af; font-size: 12px;">
      <p>&copy; <%= Date.today.year %> LibaasLoop. All rights reserved.</p>
    </div>
  </body>
</html>
