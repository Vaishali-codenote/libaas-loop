<!-- Confirmation Modal -->
<div id="confirm-modal" class="fixed inset-0 bg-black bg-opacity-50 z-50" style="display: none;">
  <div class="flex items-center justify-center min-h-screen p-4">
    <div class="bg-white rounded-lg shadow-xl max-w-md w-full p-6">
      <div class="flex items-center mb-4">
        <div class="flex-shrink-0 flex items-center justify-center w-12 h-12 rounded-full bg-red-100">
          <svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
          </svg>
        </div>
        <div class="ml-4">
          <h3 class="text-lg font-semibold text-gray-900" id="modal-title">Confirm Action</h3>
        </div>
      </div>

      <p class="text-gray-600 mb-6" id="confirm-message">Are you sure?</p>

      <div class="flex space-x-3">
        <button id="cancel-btn" class="flex-1 px-4 py-2 border border-gray-300 rounded-md text-gray-700 hover:bg-gray-50">
          Cancel
        </button>
        <button id="confirm-btn" class="flex-1 px-4 py-2 bg-red-600 text-white rounded-md hover:bg-red-700">
          Confirm
        </button>
      </div>
    </div>
  </div>
</div>

<script>
(function() {
  var modal = document.getElementById('confirm-modal');
  var cancelBtn = document.getElementById('cancel-btn');
  var confirmBtn = document.getElementById('confirm-btn');
  var modalTitle = document.getElementById('modal-title');
  var confirmMessage = document.getElementById('confirm-message');
  
  var targetForm = null;

  function showModal(message, title, form) {
    confirmMessage.textContent = message;
    modalTitle.textContent = title;
    targetForm = form;
    
    modal.style.display = 'block';
    modal.classList.remove('hidden');
  }

  function hideModal() {
    modal.style.display = 'none';
    modal.classList.add('hidden');
    targetForm = null;
    confirmBtn.disabled = false;
    confirmBtn.textContent = 'Confirm';
  }

  // Handle clicks on confirm buttons - use event delegation on document
  document.addEventListener('click', function(e) {
    // Find the button or any parent up to the form
    var btn = e.target.closest('[data-confirm-button]');
    if (!btn) return;
    
    e.preventDefault();
    e.stopPropagation();
    
    var message = btn.getAttribute('data-confirm-message') || 'Are you sure?';
    var title = btn.getAttribute('data-confirm-title') || 'Confirm';
    
    // button_to creates a form with the button inside
    // We need to find that form and intercept its submission
    var form = btn.closest('form');
    
    if (form) {
      // Remove any existing submit handlers
      var newForm = form.cloneNode(true);
      form.parentNode.replaceChild(newForm, form);
      
      // Add submit handler to the new form
      newForm.addEventListener('submit', function(e) {
        e.preventDefault();
        showModal(message, title, newForm);
      });
      
      // Trigger the submit to show modal
      newForm.dispatchEvent(new Event('submit'));
    }
  }, true); // Use capture phase to intercept before button_to's handler

  // Cancel button
  cancelBtn.addEventListener('click', function() {
    hideModal();
  });

  // Confirm button - submit the stored form
  confirmBtn.addEventListener('click', function() {
    if (!targetForm) return;
    
    confirmBtn.disabled = true;
    confirmBtn.textContent = 'Processing...';
    
    // Submit the form normally
    targetForm.submit();
  });

  // Close on backdrop click
  modal.addEventListener('click', function(e) {
    if (e.target === modal) {
      hideModal();
    }
  });

  // Close on Escape
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && modal.style.display !== 'none') {
      hideModal();
    }
  });
})();
</script>
