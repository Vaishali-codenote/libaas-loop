<% viewer = local_assigns[:viewer] %>
<% contact_name = if viewer && rental.owner_id == viewer.id
                    rental.renter.name
                  else
                    rental.owner.name
                  end %>
<% can_manage = viewer && rental.owner_id == viewer.id %>

<tr id="<%= dom_id(rental) %>">
  <td class="px-6 py-4">
    <div class="flex items-center">
      <%= image_tag listing_image_source(rental.listing), class: "w-10 h-10 object-cover rounded mr-3" %>
      <div class="text-sm font-medium text-gray-900"><%= rental.listing.title %></div>
    </div>
  </td>
  <td class="px-6 py-4">
    <div class="text-sm text-gray-500">
      <%= contact_name %>
    </div>
  </td>
  <td class="px-6 py-4 text-sm text-gray-500">
    <div><%= rental.start_date.strftime("%b %d, %Y") %></div>
    <div class="text-xs text-gray-400">to <%= rental.end_date.strftime("%b %d, %Y") %></div>
  </td>
  <td class="px-6 py-4">
    <span class="px-2 py-1 text-xs font-medium rounded-full <%= status_class(rental.status) %>">
      <%= rental.status.capitalize %>
    </span>
  </td>
  <td class="px-6 py-4 text-sm font-medium space-x-2">
    <%= link_to "View", rental_path(rental), class: "text-indigo-600 hover:text-indigo-900" %>
    <% if can_manage %>
      <% if rental.pending? %>
        <%= button_to "Approve", approve_rental_path(rental), method: :post,
            class: "text-green-600 hover:text-green-900 inline",
            data: { confirm_button: true, confirm_message: "Approve this rental?", confirm_title: "Approve Rental", method: "post" } %>
        <%= button_to "Reject", reject_rental_path(rental), method: :post,
            class: "text-red-600 hover:text-red-900 inline",
            data: { confirm_button: true, confirm_message: "Reject this rental?", confirm_title: "Reject Rental", method: "post" } %>
      <% elsif rental.approved? || rental.active? %>
        <%= button_to "Return", mark_returned_rental_path(rental), method: :post,
            class: "text-blue-600 hover:text-blue-900 inline",
            data: { confirm_button: true, confirm_message: "Mark as returned?", confirm_title: "Complete Rental", method: "post" } %>
      <% end %>
    <% end %>
  </td>
</tr>
