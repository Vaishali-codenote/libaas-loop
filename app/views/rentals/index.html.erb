<div class="max-w-6xl mx-auto px-4 py-8">
  <h1 class="text-3xl font-bold text-gray-900 mb-6">My Rentals</h1>

  <!-- Rentals as Renter -->
  <div class="mb-8">
    <h2 class="text-xl font-semibold text-gray-800 mb-4 flex items-center">
      <svg class="w-5 h-5 mr-2 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
      </svg>
      Rentals I've Requested
    </h2>
    <div class="bg-white rounded-lg shadow overflow-hidden">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Listing</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Owner</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Dates</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% if @rentals_as_renter.any? %>
            <% @rentals_as_renter.each do |rental| %>
              <tr>
                <td class="px-6 py-4">
                  <div class="flex items-center">
                    <%= image_tag listing_image_source(rental.listing), class: "w-10 h-10 object-cover rounded mr-3" %>
                    <div class="text-sm font-medium text-gray-900"><%= rental.listing.title %></div>
                  </div>
                </td>
                <td class="px-6 py-4 text-sm text-gray-500"><%= rental.owner.name %></td>
                <td class="px-6 py-4 text-sm text-gray-500">
                  <div><%= rental.start_date.strftime("%b %d, %Y") %></div>
                  <div class="text-xs text-gray-400">to <%= rental.end_date.strftime("%b %d, %Y") %></div>
                </td>
                <td class="px-6 py-4">
                  <span class="px-2 py-1 text-xs font-medium rounded-full <%= status_class(rental.status) %>">
                    <%= rental.status.capitalize %>
                  </span>
                </td>
                <td class="px-6 py-4 text-sm font-medium">
                  <%= link_to "View", rental_path(rental), class: "text-indigo-600 hover:text-indigo-900" %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="5" class="px-6 py-8 text-center text-gray-500">
                <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                </svg>
                <p class="mt-2">No rental requests yet.</p>
                <%= link_to "Browse Listings", listings_path, class: "mt-2 inline-block text-indigo-600 hover:text-indigo-800" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Rentals as Owner -->
  <div>
    <h2 class="text-xl font-semibold text-gray-800 mb-4 flex items-center">
      <svg class="w-5 h-5 mr-2 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
      </svg>
      Rentals for My Listings
    </h2>
    <div class="bg-white rounded-lg shadow overflow-hidden">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Listing</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Renter</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Dates</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% if @rentals_as_owner.any? %>
            <% @rentals_as_owner.each do |rental| %>
              <tr>
                <td class="px-6 py-4">
                  <div class="flex items-center">
                    <%= image_tag listing_image_source(rental.listing), class: "w-10 h-10 object-cover rounded mr-3" %>
                    <div class="text-sm font-medium text-gray-900"><%= rental.listing.title %></div>
                  </div>
                </td>
                <td class="px-6 py-4 text-sm text-gray-500"><%= rental.renter.name %></td>
                <td class="px-6 py-4 text-sm text-gray-500">
                  <div><%= rental.start_date.strftime("%b %d, %Y") %></div>
                  <div class="text-xs text-gray-400">to <%= rental.end_date.strftime("%b %d, %Y") %></div>
                </td>
                <td class="px-6 py-4">
                  <span class="px-2 py-1 text-xs font-medium rounded-full <%= status_class(rental.status) %>">
                    <%= rental.status.capitalize %>
                  </span>
                </td>
                <td class="px-6 py-4 text-sm font-medium space-x-2">
                  <%= link_to "View", rental_path(rental), class: "text-indigo-600 hover:text-indigo-900" %>
                  <% if rental.owner == current_user %>
                    <% if rental.pending? %>
                      <%= button_to "Approve", approve_rental_path(rental), method: :post, 
                          class: "text-green-600 hover:text-green-900 inline",
                          data: { confirm_button: true, confirm_message: "Approve this rental?", confirm_title: "Approve Rental", method: "post" } %>
                      <%= button_to "Reject", reject_rental_path(rental), method: :post, 
                          class: "text-red-600 hover:text-red-900 inline",
                          data: { confirm_button: true, confirm_message: "Reject this rental?", confirm_title: "Reject Rental", method: "post" } %>
                    <% elsif rental.approved? || rental.active? %>
                      <%= button_to "Return", mark_returned_rental_path(rental), method: :post, 
                          class: "text-blue-600 hover:text-blue-900 inline",
                          data: { confirm_button: true, confirm_message: "Mark as returned?", confirm_title: "Complete Rental", method: "post" } %>
                    <% end %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="5" class="px-6 py-8 text-center text-gray-500">
                <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
                </svg>
                <p class="mt-2">No rental requests for your listings yet.</p>
                <%= link_to "Create a Listing", new_listing_path, class: "mt-2 inline-block text-indigo-600 hover:text-indigo-800" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
